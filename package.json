{
  "name": "toki-industrial-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "build:rust": "rust-anything build rust/toki-gcode",
    "record:rust": "esbuild scripts/record-entry.ts --bundle --format=esm --platform=node --tsconfig=tsconfig.app.json --outfile=.rust-anything-original.mjs && rust-anything record rust/toki-gcode --module .rust-anything-original.mjs --count 0 --inputs scripts/rust-inputs.jsonl --float-tolerance 1e-9",
    "diff:rust": "rust-anything diff rust/toki-gcode",
    "gate:rust": "rust-anything gate rust/toki-gcode"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "rust-anything": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
